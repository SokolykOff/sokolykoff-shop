# Основные настройки Django
SECRET_KEY=django-insecure-dev-only-change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# Настройки очереди задач Celery и Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# Настройки ИИ-модуля (DeepSeek / OpenAI совместимый API)
# Если ключ не указан, автоматически используется встроенный локальный анализатор
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
# Real LLM API (необязательно). Без ключей работает локальный Smart Fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_HTTP_TIMEOUT=6

# PostgreSQL: локальный запуск; Compose автоматически задаёт HOST=db.
POSTGRES_DB=sokolykoff
POSTGRES_USER=sokolykoff
POSTGRES_PASSWORD=local-demo-change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
DB_CONN_MAX_AGE=60
